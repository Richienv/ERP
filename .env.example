# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Application URLs
# IMPORTANT: Change this to your production domain when deploying
NEXT_PUBLIC_APP_URL=https://erp-navy-eight.vercel.app

# Database
DATABASE_URL=your_database_url
DIRECT_URL=your_direct_database_url

# Other Configuration (add as needed)
# NODE_ENV=production
# ...

# Which business this deployment serves (decides what the menus and dashboard show)
#   sparepart (default) = spare-part trading: no Armada / SDM in the sidebar, Cmd+K or dashboard
#   mining              = KRI mining edition: Armada and SDM stay everywhere
NEXT_PUBLIC_BUSINESS_PROFILE=
